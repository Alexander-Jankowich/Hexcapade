      "hall_floor": [146, 132, 98, 255],
      "wall_face": [42, 50, 58, 255],
      "wall_top": [69, 78, 88, 255],
      "obstacle_face": [96, 96, 96, 255],
      "obstacle_top": [152, 152, 152, 255],
      "room_palette": [
        [98, 142, 184, 255],
        [112, 162, 110, 255],
        [168, 135, 92, 255],
        [145, 112, 170, 255],
        [172, 114, 114, 255],
        [111, 169, 166, 255]
      ]
