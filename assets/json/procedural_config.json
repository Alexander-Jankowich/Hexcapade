    "room_count_min": 6,
    "room_count_max": 10,
    "room_placement_attempts": 1200,
    "tile_size": 48.0,
    "world_scale_x": 3.4,
    "world_scale_y": 3.4,
    "world_min_grid_width": 90,
    "world_min_grid_height": 90,
    "room_width_min": 13,
    "room_width_max": 20,
    "room_height_min": 10,
    "room_height_max": 16,
    "room_buffer_tiles": 3,
    "room_edge_padding": 2,
    "hall_thickness": 2,
